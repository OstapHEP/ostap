#!/usr/bin/env sh

# =========================================================================
# Save current locale settings (or empty strings if unset)
OLD_LC_ALL="${LC_ALL:-}"
OLD_LC_CTYPE="${LC_CTYPE:-}"

# Restore initial locale settings on exit (handles script errors and Ctrl+C)
trap 'export LC_ALL="${OLD_LC_ALL}"; export LC_CTYPE="${OLD_LC_CTYPE}"' EXIT

# Override locale to standard 'C' to suppress R/ROOT LC_CTYPE startup warnings
export LC_ALL=C
export LC_CTYPE=C
# =========================================================================

# ========================================================================
# Safe argument check (POSIX compatible)
# ========================================================================
if [ -z "$1" ] || [ -z "$2" ]; then
    printf "::error::Usage: %s <LCG_version> <PLATFORM>\n" "$0"
    printf "Example: %s LCG_105 x86_64-el9-gcc13-opt\n" "$0"
    return 1 2>/dev/null || exit 1
fi

LCG="$1"
PLATFORM="$2"

printf "=== BUILD-WITH-LCG Environment Info ===\n"
printf "LCG      : %s\n" "${LCG}"
printf "PLATFORM : %s\n" "${PLATFORM}"
printf "PWD      : %s\n" "${PWD}"

source_dir="${PWD}"

# ========================================================================
# Create build directory and navigate into it
# ========================================================================
mkdir -p build && cd build || {
    printf "::error::Failed to create or enter build directory\n"
    return 2 2>/dev/null || exit 2
}

# ========================================================================
# Source LCG environment (. instead of source for 100% shell compatibility)
# ========================================================================
. ../.aux/.build-lcg "${LCG}" "${PLATFORM}" "${source_dir}"

sc=$?
if [ "${sc}" -ne 0 ]; then
    printf "::error::Error from .build-lcg (code %d): %s\n" "${sc}" "${prefix1_error}"
    return "${sc}" 2>/dev/null || exit "${sc}"
fi

if [ -z "${OSTAP_DIR}" ] || [ ! -d "${OSTAP_DIR}" ] || [ ! -f "${OSTAP_DIR}/thisostap.sh" ]; then
    printf "::error::Invalid OSTAP_DIR %s\n" "${OSTAP_DIR}"
    return 3 2>/dev/null || exit 3
fi

# =============================================================================
## Check for ostap
# =============================================================================
if ! command -v ostap >/dev/null 2>&1; then
    printf "::error::ostap is not accessible!\n"
    return 4 2>/dev/null || exit 4
fi

# =============================================================================

printf "=== BUILD-WITH-LCG Environment Info ===\n"
printf "Python binary:  %s\n" "$(which python 2>/dev/null || command -v python)"
printf "Python version: %s\n" "$(python --version 2>&1)"

# =============================================================================
# Check Python user-site directory
# =============================================================================
user_site=$(python -m site --user-site 2>/dev/null)

if [ -n "${user_site}" ] && [ -d "${user_site}" ]; then
    printf "USER-SITE directory (%s):\n" "${user_site}"
    ls -la "${user_site}"
else
    printf "No USER-SITE directory found at: %s\n" "${user_site}"
fi

# =============================================================================
# List user-installed pip packages if pip is available
# =============================================================================
if command -v pip >/dev/null 2>&1; then
    printf "=== Installed User Pip Packages ===\n"
    python -m pip list --user || true
fi

# =============================================================================
# Recheck all dependencies
# =============================================================================
if command -v check-dependencies >/dev/null 2>&1; then
    printf "=== Checking Dependencies ===\n"
    check-dependencies
else
    printf "::error::check-dependencies is not accessible!\n"
    return 5 2>/dev/null || exit 5
fi

# =============================================================================
#                                                                       The END 
# =============================================================================

