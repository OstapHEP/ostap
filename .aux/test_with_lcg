#!/usr/bin/env sh

# =============================================================================
# Safe argument check
# =============================================================================
LCG="${1:?Error: Specify LCG version (e.g., LCG_105)}"
PLATFORM="${2:?Error: Specify PLATFORM (e.g., x86_64-el9-gcc13-opt)}"

# =============================================================================
printf "=== TEST-WITH-LCG Environment Info ===\n"
printf "LCG      : %s\n" "${LCG}"
printf "PLATFORM : %s\n" "${PLATFORM}"
# =============================================================================

# =============================================================================
# Navigate into build directory safely
# =============================================================================
cd ./build || exit 1

LCG_SETUP_SCRIPT="/cvmfs/sft.cern.ch/lcg/views/${LCG}/${PLATFORM}/setup.sh"
OSTAP_SETUP_SCRIPT="./INSTALL/${LCG}/${PLATFORM}/thisostap.sh"

# Cross-platform canonical absolute path resolution (replaces GNU readlink -f / realpath -m)
get_canonical_path() {
    target_path="$1"
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import os, sys; print(os.path.abspath(os.path.realpath(sys.argv[1])))" "$target_path" 2>/dev/null
    elif command -v python >/dev/null 2>&1; then
        python -c "import os, sys; print(os.path.abspath(os.path.realpath(sys.argv[1])))" "$target_path" 2>/dev/null
    elif [ -d "$target_path" ]; then
        (cd "$target_path" && pwd -P)
    else
        echo "$target_path"
    fi
}

printf "TEST-WITH-LCG:   LCG_SETUP_SCRIPT/1 %s\n" "${LCG_SETUP_SCRIPT}"
printf "TEST-WITH-LCG: OSTAP_SETUP_SCRIPT/1 %s\n" "${OSTAP_SETUP_SCRIPT}"

LCG_SETUP_SCRIPT=$(get_canonical_path "${LCG_SETUP_SCRIPT}")
OSTAP_SETUP_SCRIPT=$(get_canonical_path "${OSTAP_SETUP_SCRIPT}")

printf "TEST-WITH-LCG:   LCG_SETUP_SCRIPT/2 %s\n" "${LCG_SETUP_SCRIPT}"
printf "TEST-WITH-LCG: OSTAP_SETUP_SCRIPT/2 %s\n" "${OSTAP_SETUP_SCRIPT}"

if [ -n "${LCG}" ] ; then
    printf "TEST-WITH-LCG:  no LCG\n"
fi
if [ -n "${PLATFORM}" ] ; then
    printf "TEST-WITH-LCG:  no PLATFORM\n"
fi

if [ -f "${LCG_SETUP_SCRIPT}" ] ; then
    printf "TEST-WITH-LCG:  no LCG_SETUP_SCRIPT %s\n" "${LCG_SETUP_SCRIPT}"
fi

if [ -f "${OSTAP_SETUP_SCRIPT}" ] ; then
    printf "TEST-WITH-LCG:  no OSTAP_SETUP_SCRIPT %s\n" "${OSTAP_SETUP_SCRIPT}"
fi

   
if [ -n "${LCG}" ] && [ -n "${PLATFORM}" ] && \
   [ -f "${LCG_SETUP_SCRIPT}" ] && [ -f "${OSTAP_SETUP_SCRIPT}" ]; then

    # =========================================================================
    printf "TEST-WITH-LCG: sourcing %s\n" "${LCG_SETUP_SCRIPT}"
    # shellcheck disable=SC1091
    . "${LCG_SETUP_SCRIPT}"
    # =========================================================================
    printf "TEST-WITH-LCG: sourcing %s\n" "${OSTAP_SETUP_SCRIPT}"
    # shellcheck disable=SC1091
    . "${OSTAP_SETUP_SCRIPT}"
    # =========================================================================

else

    # =========================================================================
    printf "(re)source .build-lcg\n"
    # shellcheck disable=SC1091
    . ../.aux/.build-lcg "${LCG}" "${PLATFORM}"
    # =========================================================================

fi

# =============================================================================
printf "=== TEST-WITH-LCG Environment Info ===\n"
printf "Python binary:  %s\n" "$(which python)"
printf "Python version: %s\n" "$(python --version 2>&1)"
# =============================================================================

# =============================================================================
# Check Python user-site directory
# =============================================================================
user_site=$(python -m site --user-site)
if [ -d "${user_site}" ]; then
    printf "TEST-WITH-LCG:      USER-SITE directory %s\n" "${user_site}"
    ls -la "${user_site}"
else
    printf "TEST-WITH-LCG:   no USER-SITE directory %s\n" "${user_site}"
fi

# =============================================================================
# List user-installed pip packages if pip is available
# =============================================================================
if command -v pip >/dev/null 2>&1; then
    python -m pip list --user || true
fi

# =============================================================================
# Recheck all dependencies
# =============================================================================
if command -v check-dependencies >/dev/null 2>&1; then
    COLUMNS=200 check-dependencies
fi

# =============================================================================
# Run tests
# =============================================================================
## OSTAP_BATCH=True COLUMNS=200 ctest -j4 --output-on-failure --test-output-size-failed 5000000
OSTAP_BATCH=True COLUMNS=200 ctest -j4 -R core.core --output-on-failure --test-output-size-failed 5000000

# =============================================================================
#                                                                       The END
# =============================================================================

