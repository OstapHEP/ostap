#!/usr/bin/env sh

# =========================================================================
# Save current locale settings (or empty strings if unset)
OLD_LC_ALL="${LC_ALL:-}"
OLD_LC_CTYPE="${LC_CTYPE:-}"

# Restore initial locale settings on exit (handles script errors and Ctrl+C)
trap 'export LC_ALL="${OLD_LC_ALL}"; export LC_CTYPE="${OLD_LC_CTYPE}"' EXIT

# Override locale to standard 'C' to suppress R/ROOT LC_CTYPE startup warnings
export LC_ALL=C
export LC_CTYPE=C
# =========================================================================

# =============================================================================
# Safe argument check (POSIX compatible)
# =============================================================================
if [ -z "$1" ] || [ -z "$2" ]; then
    printf "::error::Usage: %s <LCG_version> <PLATFORM>\n" "$0"
    printf "Example: %s LCG_105 x86_64-el9-gcc13-opt\n" "$0"
    return 1 2>/dev/null || exit 1
fi

LCG="$1"
PLATFORM="$2"

printf "=== TEST-WITH-LCG Environment Info ===\n"
printf "LCG      : %s\n" "${LCG}"
printf "PLATFORM : %s\n" "${PLATFORM}"
printf "PWD      : %s\n" "${PWD}"

source_dir="${PWD}"

# =========================================================================
# Cross-platform canonical absolute path resolution
# =========================================================================
get_canonical_path() {
    target_path="$1"

    # 1. Directory (or symlink to directory)
    if [ -d "${target_path}" ]; then
        (cd "${target_path}" 2>/dev/null && pwd -P)

    # 2. File (or symlink to file)
    elif [ -f "${target_path}" ]; then
        dir_name=$(dirname "${target_path}")
        file_name=$(basename "${target_path}")
        abs_dir=$(cd "${dir_name}" 2>/dev/null && pwd -P)
        if [ -n "${abs_dir}" ]; then
            printf "%s/%s\n" "${abs_dir}" "${file_name}"
        else
            echo "${target_path}"
        fi

    # 3. Fallback for non-existent paths
    else
        echo "${target_path}"
    fi
}

# =============================================================================
# Navigate into build directory safely
# =============================================================================
mkdir -p build && cd ./build || {
    printf "::error::Failed to enter build directory\n"
    return 1 2>/dev/null || exit 1
}

LCG_SETUP_SCRIPT="/cvmfs/sft.cern.ch/lcg/views/${LCG}/${PLATFORM}/setup.sh"
OSTAP_SETUP_SCRIPT="./INSTALL/${LCG}/${PLATFORM}/thisostap.sh"

LCG_SETUP_SCRIPT=$(get_canonical_path "${LCG_SETUP_SCRIPT}")
OSTAP_SETUP_SCRIPT=$(get_canonical_path "${OSTAP_SETUP_SCRIPT}")

printf "TEST-WITH-LCG:   LCG_SETUP_SCRIPT %s\n" "${LCG_SETUP_SCRIPT}"
printf "TEST-WITH-LCG: OSTAP_SETUP_SCRIPT %s\n" "${OSTAP_SETUP_SCRIPT}"

if [ -n "${LCG}" ] && [ -n "${PLATFORM}" ] && \
   [ -f "${LCG_SETUP_SCRIPT}" ] && [ -f "${OSTAP_SETUP_SCRIPT}" ]; then

    # =========================================================================
    printf "TEST-WITH-LCG: sourcing %s\n" "${LCG_SETUP_SCRIPT}"
    # shellcheck disable=SC1091
    . "${LCG_SETUP_SCRIPT}"
    
    sc=$?
    if [ "${sc}" -ne 0 ]; then
        printf "::error::Error from '. %s' (code %d)\n" "${LCG_SETUP_SCRIPT}" "${sc}"
        return "${sc}" 2>/dev/null || exit "${sc}"
    fi
    
    # =========================================================================
    printf "TEST-WITH-LCG: sourcing %s\n" "${OSTAP_SETUP_SCRIPT}"
    # shellcheck disable=SC1091
    . "${OSTAP_SETUP_SCRIPT}"
    
    sc=$?
    if [ "${sc}" -ne 0 ]; then
        printf "::error::Error from '. %s' (code %d)\n" "${OSTAP_SETUP_SCRIPT}" "${sc}"
        return "${sc}" 2>/dev/null || exit "${sc}"
    fi

else
    
    # =========================================================================
    printf "(re)source .build-lcg\n"
    # FIXED: Fixed syntax error in ${source_dir} and ensured correct path to build_with_lcg
    ( cd "${source_dir}" && ./.aux/build_with_lcg "${LCG}" "${PLATFORM}" )
    
    sc=$?
    if [ "${sc}" -ne 0 ]; then
        printf "::error::Error from build-with-lcg (code %d)\n" "${sc}"
        return "${sc}" 2>/dev/null || exit "${sc}"
    fi
fi

# =============================================================================
printf "=== TEST-WITH-LCG Environment Info ===\n"
printf "Python binary:  %s\n" "$(command -v python 2>/dev/null || which python)"
printf "Python version: %s\n" "$(python --version 2>&1)"
# =============================================================================

# =============================================================================
# Check Python user-site directory
# =============================================================================
user_site=$(python -m site --user-site 2>/dev/null)
if [ -n "${user_site}" ] && [ -d "${user_site}" ]; then
    printf "TEST-WITH-LCG:      USER-SITE directory %s\n" "${user_site}"
    ls -la "${user_site}"
else
    printf "TEST-WITH-LCG:   no USER-SITE directory %s\n" "${user_site}"
fi

# =============================================================================
# List user-installed pip packages if pip is available
# =============================================================================
if command -v pip >/dev/null 2>&1; then
    python -m pip list --user || true
fi

# =============================================================================
# Recheck all dependencies
# =============================================================================
if command -v check-dependencies >/dev/null 2>&1; then
    COLUMNS=200 check-dependencies
fi

# =============================================================================
# Run tests
# =============================================================================
nproc_val=$(nproc 2>/dev/null || sysctl -n hw.logicalcpu 2>/dev/null || echo 2)
ncpus=$(( nproc_val - 2 > 2 ? nproc_val - 2 : 2 ))

OSTAP_BATCH=True COLUMNS=200 ctest -j${ncpus} -R ipypa --output-on-failure --test-output-size-failed 5000000

# =============================================================================
#                                                                       The END
# =============================================================================

