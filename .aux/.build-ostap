#!/usr/bin/env sh

# =========================================================================
# Save current locale settings (or empty strings if unset)
OLD_LC_ALL="${LC_ALL:-}"
OLD_LC_CTYPE="${LC_CTYPE:-}"

# Restore initial locale settings on exit (handles script errors and Ctrl+C)
trap 'export LC_ALL="${OLD_LC_ALL}"; export LC_CTYPE="${OLD_LC_CTYPE}"' EXIT

# Override locale to standard 'C' to suppress R/ROOT LC_CTYPE startup warnings
export LC_ALL=C
export LC_CTYPE=C
# =========================================================================


prefix1='<<BUILD OSTAP>>'
prefix1_error='<<BUILD OSTAP *ERROR*>>'
prefix='<<BUILD OSTAP>>'
prefix_error='<<BUILD OSTAP *ERROR*>>'

# =========================================================================
# Portable Helper Functions
# =========================================================================

# =========================================================================
# Cross-platform CPU core count
# =========================================================================
get_cpu_count() {
    if command -v nproc >/dev/null 2>&1; then
        nproc
    elif command -v sysctl >/dev/null 2>&1; then
        sysctl -n hw.ncpu 2>/dev/null || echo 1
    else
        echo 1
    fi
}

# =========================================================================
# Universal POSIX-compliant Canonical Absolute Path Resolution
# (Works in bash, zsh, dash, sh)
# =========================================================================
if ! command -v canonical_path >/dev/null 2>&1; then
printf "%s Use local 'canonical_path' function \n" "${prefix1}"
canonical_path() {
    # =====================================================================
    # 1. Use native realpath if available
    # =====================================================================
    if command -v realpath >/dev/null 2>&1; then
        realpath -m -- "$1" 2>/dev/null && return 0
    elif command -v grealpath >/dev/null 2>&1; then
        grealpath -m -- "$1" 2>/dev/null && return 0
    fi

    # ======================================================================
    # 2. Pure POSIX fallback (no 'local' keyword to ensure compatibility with plain sh)
    # ======================================================================
    if [ -z "$1" ]; then
        return 1
    fi
    
    if [ -e "$1" ]; then
        if [ -d "$1" ]; then
            (cd -- "$1" 2>/dev/null && pwd -P)
        else
            _gp_dir=$(dirname -- "$1")
            _gp_file=$(basename -- "$1")
            _gp_abs=$(cd -- "$_gp_dir" 2>/dev/null && pwd -P)
            if [ -n "$_gp_abs" ]; then
                printf '%s/%s\n' "$_gp_abs" "$_gp_file"
            else
                printf '%s\n' "$1"
            fi
        fi
    else
        _gp_current="$1"
        _gp_suffix=""
        
        while [ ! -e "$_gp_current" ] && [ "$_gp_current" != "." ] && [ "$_gp_current" != "/" ]; do
            _gp_suffix="/$(basename -- "$_gp_current")${_gp_suffix}"
            _gp_current=$(dirname -- "$_gp_current")
        done
        
        if [ -e "$_gp_current" ]; then
            _gp_abs=$(canonical_path "$_gp_current")
            printf '%s%s\n' "$_gp_abs" "$_gp_suffix"
        else
            printf '%s/%s\n' "$PWD" "$1"
        fi
    fi
}
fi

# ==========================================================================
## Color output setup
# ==========================================================================
if command -v tput >/dev/null 2>&1; then
    COLORS=$(tput colors 2>/dev/null || echo 0)
else
    COLORS=0
fi

if [ "$COLORS" -gt 2 ]; then
    # Generate literal ESC byte portably in POSIX sh
    ESC=$(printf '\033')

    COLOR_OK="${ESC}[1;97m${ESC}[42m"
    COLOR_ERR="${ESC}[1;93m${ESC}[6;101m"
    COLOR_OFF="${ESC}[0m"

    prefix="${COLOR_OK}${prefix}${COLOR_OFF}"
    prefix_error="${COLOR_ERR}${prefix_error}${COLOR_OFF}"
    prefix1="${COLOR_OK}${prefix1}${COLOR_OFF}"
    prefix1_error="${COLOR_ERR}${prefix1_error}${COLOR_OFF}"
fi


# ==========================================================================
## Get parameters
# ==========================================================================
OSTAP_SOURCE="${1:-${OSTAP_SOURCE}}"
OSTAP_INSTALL="${2:-${OSTAP_INSTALL}}"
OSTAP_BUILD="${3:-${OSTAP_BUILD}}"

# ==========================================================================
## Valid ROOTSYS?
# ==========================================================================
if [ -n "${ROOTSYS}" ] && \
   [ -d "${ROOTSYS}" ] && \
   [ -d "${ROOTSYS}/bin" ] && \
   [ -x "${ROOTSYS}/bin/root" ] && \
   [ -x "${ROOTSYS}/bin/root.exe" ] && \
   [ -x "${ROOTSYS}/bin/root-config" ]; then
    :
else
    printf "%s No valid ROOTSYS directory: %s\n" "${prefix1_error}" "${ROOTSYS}"
    return 210 2>/dev/null || exit 210
fi

# ==========================================================================
## Valid source directory?
# ==========================================================================
if [ -n "${OSTAP_SOURCE}" ] && \
   [ -d "${OSTAP_SOURCE}" ] && \
   [ -d "${OSTAP_SOURCE}/cmake" ] && \
   [ -d "${OSTAP_SOURCE}/data" ] && \
   [ -d "${OSTAP_SOURCE}/docs" ] && \
   [ -d "${OSTAP_SOURCE}/examples" ] && \
   [ -d "${OSTAP_SOURCE}/ostap" ] && \
   [ -d "${OSTAP_SOURCE}/scripts" ] && \
   [ -d "${OSTAP_SOURCE}/source" ] && \
   [ -d "${OSTAP_SOURCE}/ReleaseNotes" ] && \
   [ -f "${OSTAP_SOURCE}/CMakeLists.txt" ]; then

    OSTAP_SOURCE=$(canonical_path "${OSTAP_SOURCE}")
    printf "%s Use OSTAP_SOURCE      = %s\n" "${prefix1}" "${OSTAP_SOURCE}"
else
    printf "%s No valid source directory is found! %s\n" "${prefix1_error}" "${OSTAP_SOURCE}"
    unset OSTAP_SOURCE OSTAP_BUILD OSTAP_INSTALL
    return 211 2>/dev/null || exit 211
fi

# ==========================================================================
## INSTALL directory
# ==========================================================================
if [ -n "${OSTAP_INSTALL}" ]; then
    OSTAP_INSTALL=$(canonical_path "${OSTAP_INSTALL}")
else
    OSTAP_INSTALL="./INSTALL"
    OSTAP_INSTALL=$(canonical_path "${OSTAP_INSTALL}")
fi

if [ -d "${OSTAP_INSTALL}" ] && [ ! -w "${OSTAP_INSTALL}" ]; then
    printf "%s Directory OSTAP_INSTALL is not writeable! %s\n" "${prefix1_error}" "${OSTAP_INSTALL}"
    unset OSTAP_BUILD OSTAP_INSTALL
    return 212 2>/dev/null || exit 212
fi

printf "%s Use OSTAP_INSTALL     = %s\n" "${prefix1}" "${OSTAP_INSTALL}"

# =========================================================================
## Valid build directory (1)?
# ==========================================================================
ostap_build_upper=$(echo "${OSTAP_BUILD}" | tr '[:lower:]' '[:upper:]')

if [ -n "${OSTAP_BUILD}" ] && [ -d "${OSTAP_BUILD}" ] && [ -w "${OSTAP_BUILD}" ]; then

    ## OSTAP_BUILD=$(canonical_path "${OSTAP_BUILD}")
    printf "%s Use OSTAP_BUILD       = %s\n" "${prefix1}" "${OSTAP_BUILD}"

elif [ -n "${OSTAP_BUILD}" ] && [ "${ostap_build_upper}" = "TMP" ]; then

    OSTAP_BUILD=$(mktemp -d -t "ostap-$(date '+%Y-%b-%d')-OSTAP-BUILD-DIR-XXXXXX")
    printf "%s Build directory is created %s\n" "${prefix}" "${OSTAP_BUILD}"

elif [ -d "${OSTAP_SOURCE}/build" ] && [ -w "${OSTAP_SOURCE}/build" ]; then

    OSTAP_BUILD=$(canonical_path "${OSTAP_SOURCE}/build")
    printf "%s Use OSTAP_BUILD       = %s\n" "${prefix1}" "${OSTAP_BUILD}"

elif [ -w "${OSTAP_SOURCE}" ] && [ ! -d "${OSTAP_SOURCE}/build" ]; then

    mkdir -p "${OSTAP_SOURCE}/build"
    printf "%s Build directory is created %s\n" "${prefix1}" "${OSTAP_BUILD}"

else

    OSTAP_BUILD=$(mktemp -d -t "ostap-$(date '+%Y-%b-%d')-OSTAP-BUILD-DIR-XXXXXX")
    printf "%s Build directory is created %s\n" "${prefix1}" "${OSTAP_BUILD}"

fi

# =========================================================================
## Valid build directory (2)?
# ==========================================================================
if [ -n "${OSTAP_BUILD}" ] && [ -d "${OSTAP_BUILD}" ] && [ -w "${OSTAP_BUILD}" ]; then
    OSTAP_BUILD=$(canonical_path "${OSTAP_BUILD}")
else
    printf "%s No valid build directory is found! %s\n" "${prefix1_error}" "${OSTAP_BUILD}"
    unset OSTAP_BUILD OSTAP_INSTALL
    return 213 2>/dev/null || exit 213
fi

# ==========================================================================
## Tool checks
# ==========================================================================
if command -v python >/dev/null 2>&1; then
    printf "%s PYTHON                : %s\n" "${prefix1}" "$(command -v python)"
    printf "%s PYTHON version        : %s\n" "${prefix1}" "$(python --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')"
else
    printf "%s PYTHON is not found!\n" "${prefix1_error}"
    return 214 2>/dev/null || exit 214
fi 

# ==========================================================================
if command -v pip >/dev/null 2>&1; then
    printf "%s PIP                   : %s\n" "${prefix1}" "$(command -v pip)"
    printf "%s PIP    version        : %s\n" "${prefix1}" "$(pip --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')"
else
    printf "%s PIP    is not found!\n" "${prefix1_error}"
    ## return 214
fi 

if command -v cmake >/dev/null 2>&1; then
    printf "%s CMAKE                 : %s\n" "${prefix1}" "$(command -v cmake)"
    printf "%s CMAKE version         : %s\n" "${prefix1}" "$(cmake --version | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')"
else
    printf "%s CMAKE is not found!\n" "${prefix1_error}"
    return 215 2>/dev/null || exit 215
fi

if command -v ctest >/dev/null 2>&1; then
    printf "%s CTEST                 : %s\n" "${prefix1}" "$(command -v ctest)"
    printf "%s CTEST version         : %s\n" "${prefix1}" "$(ctest --version | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')"
else
    printf "%s CTEST is not found!\n" "${prefix1_error}"
    return 216 2>/dev/null || exit 216
fi

if command -v cpack >/dev/null 2>&1; then
    printf "%s CPACK                 : %s\n" "${prefix1}" "$(command -v cpack)"
    printf "%s CPACK version         : %s\n" "${prefix1}" "$(cpack --version | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')"
else
    printf "%s CPACK is not found!\n" "${prefix1_error}"
    return 217 2>/dev/null || exit 217
fi

make_command=""
make_generator=""
if command -v ninja >/dev/null 2>&1; then
    make_command="ninja"
    make_generator="Ninja"
    printf "%s NINJA                 : %s\n" "${prefix1}" "$(command -v ninja)"
    printf "%s NINJA version         : %s\n" "${prefix1}" "$(ninja --version | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')"
elif command -v gmake >/dev/null 2>&1; then
    make_command="gmake"
    make_generator="Unix Makefiles"
    printf "%s GMAKE                 : %s\n" "${prefix1}" "$(command -v gmake)"
    printf "%s GMAKE version         : %s\n" "${prefix1}" "$(gmake --version | grep -Eo '[0-9]+\.[0-9]+')"
elif command -v make >/dev/null 2>&1; then
    make_command="make"
    make_generator="Unix Makefiles"
    printf "%s MAKE                  : %s\n" "${prefix1}" "$(command -v make)"
    printf "%s MAKE version          : %s\n" "${prefix1}" "$(make --version | grep -Eo '[0-9]+\.[0-9]+')"
else
    printf "%s neither NINJA nor (G)MAKE is found!\n" "${prefix1_error}"
    return 218
fi

# =========================================================================
## Environment sanitization
# =========================================================================
if [ -n "${PYTHONNOUSERSITE}" ]; then
    printf "%s unset PYTHONNOUSERSITE %s\n" "${prefix1}" "${PYTHONNOUSERSITE}"
    unset PYTHONNOUSERSITE
fi

# =========================================================================
## Clean install directory
# ==========================================================================

# =========================================================================
## Clean install directory (1) 
# =========================================================================
if [ -n "${OSTAP_INSTALL}" ] && [ -d "${OSTAP_INSTALL}" ] && [ -w "${OSTAP_INSTALL}" ]; then
    ## OSTAP_INSTALL=$(canonical_path "${OSTAP_INSTALL}")

    printf "%s [1/8] Clean OSTAP_INSTALL directory %s\n" "${prefix1}" "${OSTAP_INSTALL}"
    
    ( cd "${OSTAP_INSTALL}" && \
      rm -rf .footprints .ostap.build .ostaprc .rootlogon.C cmake examples include lib scripts thisostap.sh packages )

    sc=$?
    if [ "${sc}" -ne 0 ]; then
        printf "%s [1/8] FAILURE: Cannot clean OSTAP_INSTALL (code %d) %s\n" "${prefix1_error}" "${sc}" "${OSTAP_INSTALL}"
    else
        printf "%s [1/8] SUCCESS: OSTAP_INSTALL is cleaned (code %d) %s\n" "${prefix1}" "${sc}" "${OSTAP_INSTALL}"
    fi
fi

# =========================================================================
## Clean build directory (2)
# ==========================================================================
if [ -f "${OSTAP_BUILD}/build.ninja" ] && [ "${make_command}" = "ninja" ]; then
    
    printf "%s [2/7] Clean  OSTAP_BUILD   build remnants   %s\n" "${prefix1}" "${OSTAP_BUILD}"
    ( cd "${OSTAP_BUILD}" && "${make_command}" clean )
    
    sc=$?
    if [ "${sc}" -ne 0 ]; then
        printf "%s [2/8] FAILURE: Cannot clean OSTAP_BUILD (code %d) %s\n" "${prefix1_error}" "${sc}" "${OSTAP_INSTALL}"
    else
        printf "%s [2/8] SUCCESS: OSTAP_BUILD is cleaned (code %d) %s\n" "${prefix1}" "${sc}" "${OSTAP_INSTALL}"
    fi

elif [ -f "${OSTAP_BUILD}/Makefile" ] && [ "${make_command}" != "ninja" ]; then
    
    printf "%s [2/7] Clean  OSTAP_BUILD   build remnants   %s\n" "${prefix1}" "${OSTAP_BUILD}"
    ( cd "${OSTAP_BUILD}" && "${make_command}" clean )

    sc=$?
    if [ "${sc}" -ne 0 ]; then
        printf "%s [2/8] FAILURE: Cannot clean OSTAP_BUILD (code %d) %s\n" "${prefix1_error}" "${sc}" "${OSTAP_INSTALL}"
    else
        printf "%s [2/8] SUCCESS: OSTAP_BUILD is cleaned (code %d) %s\n" "${prefix1}" "${sc}" "${OSTAP_INSTALL}"
    fi
fi

# =========================================================================
## Clean build directory (2)
# ==========================================================================
printf "%s [3/8] Remove OSTAP_BUILD   remnants&garbage %s\n" "${prefix1}" "${OSTAP_BUILD}"
( cd "${OSTAP_BUILD}" && \
  rm -rf -- CM* CP* CT* *nin* scripts/ source/ ostap/ examples/ Testing/ Ma* .nin* Dart* cmake* instal* packages Tes* *.py~ *.C~ __* _CPack* \#* *~ .*~ .\#* )

sc=$?
if [ "${sc}" -ne 0 ]; then
    printf "%s [3/8] FAILURE: Cannot remove OSTAP_BUILD remnants&garbage (code %d) %s\n" "${prefix1_error}" "${sc}" "${OSTAP_BUILD}"
else
    printf "%s [3/8] SUCCESS: OSTAP_BUILD remnants&garbage is removed (code %d) %s\n" "${prefix1}" "${sc}" "${OSTAP_BUILD}"
fi

# ==========================================================================
# Check if CMake supports the "--fresh" option (available in CMake 3.24+)
# ==========================================================================

# Extract the version string (matches both X.Y and X.Y.Z formats)
cmake_ver=$(cmake --version | head -n 1 | grep -Eo '[0-9]+\.[0-9]+(\.[0-9]+)?')

# Parse major and minor version numbers
cmake_major=$(echo "$cmake_ver" | cut -d. -f1)
cmake_minor=$(echo "$cmake_ver" | cut -d. -f2)

# Fallback to 0 if parsing fails to prevent syntax errors during integer comparison
cmake_major=${cmake_major:-0}
cmake_minor=${cmake_minor:-0}

# Enable the --fresh flag if CMake version is 3.24 or higher
fresh=""
if [ "$cmake_major" -gt 3 ] || { [ "$cmake_major" -eq 3 ] && [ "$cmake_minor" -ge 24 ]; }; then
    fresh="--fresh"
fi

# Retrieve the number of available CPU cores
NCPU=$(get_cpu_count)


# =========================================================================
## (FRESH) build
# ==========================================================================
printf "%s [4/8] First  pass of cmake&%s&install    %s\n" "${prefix1}" "${make_command}" "${OSTAP_BUILD}"
( cd "${OSTAP_BUILD}" && \
  cmake ${fresh} "${OSTAP_SOURCE}" -DCMAKE_INSTALL_PREFIX="${OSTAP_INSTALL}" -G "${make_generator}" && \
  "${make_command}" -j"${NCPU}" && \
  "${make_command}" install | grep -v Up-to-date | grep -v Installing )

sc=$?
if [ "${sc}" -ne 0 ]; then
    printf "%s [4/8] FAILURE: first pass of cmake&%s&install (code %d) %s\n" "${prefix1_error}" "${make_command}" "${sc}" "${OSTAP_BUILD}"
else
    printf "%s [4/8] SUCCESS: first pass of cmake&%s&install (code %d) %s\n" "${prefix}" "${make_command}" "${sc}" "${OSTAP_BUILD}"
fi

# ==========================================================================
## Check install directory existence
# ==========================================================================
if [ ! -d "${OSTAP_INSTALL}" ]; then
    printf "%s Missing install directory! %s\n" "${prefix1_error}" "${OSTAP_INSTALL}"
    unset OSTAP_BUILD OSTAP_INSTALL
    return 219  2>/dev/null || exit 219 
else 
    printf "%s OSTAP_INSTALL is found %s\n" "${prefix}" "${OSTAP_INSTALL}"
fi

# =========================================================================
## Second Pass
# ==========================================================================
printf "%s [5/8] Second pass of cmake&%s&install %s\n" "${prefix1}" "${make_command}" "${OSTAP_BUILD}"
( cd "${OSTAP_BUILD}" && \
  cmake "${OSTAP_SOURCE}" -DCMAKE_INSTALL_PREFIX="${OSTAP_INSTALL}" -G "${make_generator}" && \
  "${make_command}" -j"${NCPU}" && \
  "${make_command}" install | grep -v Up-to-date | grep -v Installing )

sc=$?
if [ "${sc}" -ne 0 ]; then
    printf "%s [5/8] FAILURE: second pass of cmake&%s&install (code %d) %s\n" "${prefix1_error}" "${make_command}" "${sc}" "${OSTAP_BUILD}"
else
    printf "%s [5/8] SUCCESS: second pass of cmake&%s&install (code %d) %s\n" "${prefix}" "${make_command}" "${sc}" "${OSTAP_BUILD}"
fi

# =========================================================================
## Source setup script
# ==========================================================================
if [ -f "${OSTAP_INSTALL}/thisostap.sh" ] && [ -r "${OSTAP_INSTALL}/thisostap.sh" ]; then
    printf "%s [6/8] 'thisostap.sh' is sourced %s\n" "${prefix1}" "${OSTAP_INSTALL}/thisostap.sh"
    . "${OSTAP_INSTALL}/thisostap.sh"
else
    printf "%s [6/8] FAILURE: no thisostap.sh is found %s\n" "${prefix1_error}" "${OSTAP_INSTALL}/thisostap.sh"
    unset OSTAP_BUILD OSTAP_INSTALL
    return 220  2>/dev/null || exit 220
fi

sc=$?
if [ "${sc}" -ne 0 ]; then
    printf "%s [6/8] FAILURE: '. %s' (code %d)\n" "${prefix1_error}" "${OSTAP_INSTALL}/thisostap.sh" "${sc}"
    return ${sc} 2>/dev/null || exit ${sc}
else
    printf "%s [6/8] SUCCESS: '. %s' (code %d)\n" "${prefix}" "${OSTAP_INSTALL}/thisostap.sh" "${sc}"
fi


# =========================================================================
## Third Pass
# ==========================================================================
printf "%s [7/8] Third  pass of cmake&%s&install    %s\n" "${prefix1}" "${make_command}" "${OSTAP_BUILD}"
( cd "${OSTAP_BUILD}" && \
  cmake "${OSTAP_SOURCE}" -DCMAKE_INSTALL_PREFIX="${OSTAP_INSTALL}" -G "${make_generator}" && \
  "${make_command}" -j"${NCPU}" && \
  "${make_command}" install | grep -v Up-to-date | grep -v Installing )

sc=$?
if [ "${sc}" -ne 0 ]; then
    printf "%s [7/8] FAILURE: third pass of cmake&%s&install (code %d) %s\n" "${prefix1_error}" "${make_command}" "${sc}" "${OSTAP_BUILD}"
    return ${sc} 2>/dev/null || exit ${sc}
else
    printf "%s [7/8] SUCCESS: third pass of cmake&%s&install (code %d) %s\n" "${prefix}" "${make_command}" "${sc}" "${OSTAP_BUILD}"
fi

OSTAP_BUILDER="${make_command}"
printf "%s PROJECT BUILDER : %s\n" "${prefix1}" "${OSTAP_BUILDER}"
printf "%s ROOTSYS         : %s\n" "${prefix1}" "${ROOTSYS}"
printf "%s OSTAP_DIR       : %s\n" "${prefix1}" "${OSTAP_DIR}"
printf "%s OSTAP_SOURCE    : %s\n" "${prefix1}" "${OSTAP_SOURCE}"
printf "%s OSTAP_BUILD     : %s\n" "${prefix1}" "${OSTAP_BUILD}"
printf "%s OSTAP_INSTALL   : %s\n" "${prefix1}" "${OSTAP_INSTALL}"
printf "%s thisostap.sh    : %s/thisostap.sh\n" "${prefix1}" "${OSTAP_INSTALL}"
printf "%s root            : %s\n" "${prefix1}" "$(command -v root)"
printf "%s root.exe        : %s\n" "${prefix1}" "$(command -v root.exe)"
printf "%s root version    : %s\n" "${prefix1}" "$(root.exe --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')"
printf "%s python          : %s\n" "${prefix1}" "$(command -v python)"
printf "%s python version  : %s\n" "${prefix1}" "$(python --version | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+')"
printf "%s ostap           : %s\n" "${prefix1}" "$(command -v ostap)"
printf "%s ostap version   : %s\n" "${prefix1}" "$(ostap --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+')"

if command -v tree >/dev/null 2>&1; then
    tree -d -L 3 --charset UTF-8 "${OSTAP_INSTALL}"
else
    ls "${OSTAP_INSTALL}"
fi

if command -v pip >/dev/null 2>&1; then
    python -m pip list --user
fi

export OSTAP_BUILDER
export OSTAP_SOURCE
export OSTAP_BUILD
export OSTAP_INSTALL

result=${sc}
if [ "$result" -eq 0 ]; then
    printf "%s RESULT             : SUCCESS\n"    "${prefix1}"
else
    printf "%s RESULT             : FAILURE %s\n" "${prefix1_error}" "${result}"
fi

return ${result} 2>/dev/null || exit ${result}

# ===================================================================================
#                                                                           The END
# ===================================================================================
