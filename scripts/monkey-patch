#!/usr/bin/env python
# -*- coding: utf-8 -*-
# =============================================================================
# @file   scripts/monkey-patch
# Identify all ``monkey-patch'' occurences for python files 
# @author Vanya Belyaev Ivan.Belyaev@itep.ru
