""" Identify all ``monkey-patch'' occurences for python files 
"""
# =============================================================================
__version__ = "$Revision:"
__author__  = "Vanya BELYAEV Ivan.Belyaev@itep.ru"
__date__    = "2011-07-25"
__all__     = () 
# =============================================================================

if '__main__' == __name__ :
    
    from argparse import ArgumentParser 
    parser = ArgumentParser  (
        prog        = 'monkey-patch' , 
        description = "Perform static AST analysis to identify ``monkey-patches'' in PY-files"
    )     
    
    parser.add_argument ( 'files' , nargs = '+' , help = 'List of PY-files to inspect' ) 

    
    args = parser.parse_args   () 

    if args.files :

        from ostap.logger.logger import getLogger
        logger = getLogger ( 'monkey-patches' )

        import ostap.utils.monkey_patch as MP 

        for f in args.files : MP.monkey_patch ( f , logger = logger ) 

# =============================================================================
##                                                                      The END 
# =============================================================================
